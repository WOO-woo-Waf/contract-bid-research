# MinerU public file-stream task API. TLS verification is always enabled.
MINERU_BASE_URL=https://mineru.example.invalid
MINERU_TOKEN=
MINERU_CA_BUNDLE=
MINERU_CONNECT_TIMEOUT_S=30
MINERU_READ_TIMEOUT_S=120
MINERU_TASK_TIMEOUT_S=1800
MINERU_POLL_INTERVAL_S=2

# OpenAI-compatible model API. Keep the real key in .env only.
MODEL_API_BASE_URL=https://model-api.example.invalid/v1
MODEL_API_KEY=
MODEL_API_TIMEOUT_S=120
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=qwen3-rerank
CHAT_MODEL=qwen-plus

# Optional compatibility aliases for later LLM consumers.
LLM_BASE_URL=https://model-api.example.invalid/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW_TOKENS=128000

# Portable runtime paths. Mount these paths when running the container.
CONTRACT_BID_DATA_ROOT=./data
CONTRACT_BID_ARTIFACTS_ROOT=./artifacts
CONTRACT_BID_KNOWLEDGE_DB=./runtime/knowledge.sqlite3
GBRAIN_REPOSITORY=./references/gbrain
GBRAIN_HOME=./runtime/gbrain
