# Generic OpenAI-compatible model configuration. Keep real keys in .env only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW_TOKENS=128000

# Optional parser override. Local parsing remains the safe default.
PARSER_PROVIDER=local
PARSER_LLM_BASE_URL=
PARSER_LLM_API_KEY=
PARSER_LLM_MODEL=
MINERU_BASE_URL=
MINERU_TOKEN=

# Local experiment paths. Never point these at committed customer documents.
CONTRACT_BID_DATA_ROOT=./data
CONTRACT_BID_ARTIFACTS_ROOT=./artifacts
